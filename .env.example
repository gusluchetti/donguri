# ─── Database ────────────────────────────────────────────────────────────────
# Dev: local Postgres via `bun run db:up` (docker-compose.yml)
# Prod: Neon Postgres (set via fly secrets)
# Neon format: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/donguri
DATABASE_URL="postgresql://postgres:password@localhost:5433/donguri"

# ─── AT Protocol OAuth ───────────────────────────────────────────────────────
# ES256 private key in JWK format
# Generate: bun -e "const k=await crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']);const j=await crypto.subtle.exportKey('jwk',k.privateKey);j.alg='ES256';console.log(JSON.stringify(j))"
OAUTH_PRIVATE_KEY_JWK={"crv":"P-256","d":"<base64url>","kty":"EC","x":"<base64url>","y":"<base64url>","alg":"ES256"}

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-string"

# ─── Public URL ──────────────────────────────────────────────────────────────
# Local dev (AT Proto PDS can't reach you — Google/GitHub OAuth still works):
PUBLIC_URL="http://127.0.0.1:3000"
# For AT Proto OAuth, use cloudflared tunnel (bun run dev:tunnel):
# PUBLIC_URL="https://dev.donguri.app"

# ─── OAuth Providers (optional) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Cover Art (optional — for import/covers.ts) ────────────────────────────
# TMDB_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# ─── Payment (Lemon Squeezy) ─────────────────────────────────────────────
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_RANGER_MONTHLY_VARIANT_ID=
# LEMONSQUEEZY_RANGER_ANNUAL_VARIANT_ID=
# LEMONSQUEEZY_RANGER_LIFETIME_VARIANT_ID=
# LEMONSQUEEZY_DISCOUNT_PPP_60=
