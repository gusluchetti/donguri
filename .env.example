# ─── Database ────────────────────────────────────────────────────────────────
# Dev: local Postgres via `bun run db:up` (docker-compose.yml)
# Prod: Neon Postgres (set via fly secrets)
# Neon format: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/donguri
DATABASE_URL="postgresql://postgres:password@localhost:5433/donguri"

# ─── AT Protocol OAuth ───────────────────────────────────────────────────────
# ES256 private key in JWK format
# Generate: bun -e "const k=await crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']);const j=await crypto.subtle.exportKey('jwk',k.privateKey);j.alg='ES256';console.log(JSON.stringify(j))"
OAUTH_PRIVATE_KEY_JWK={"crv":"P-256","d":"<base64url>","kty":"EC","x":"<base64url>","y":"<base64url>","alg":"ES256"}

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-string"

# ─── Public URL ──────────────────────────────────────────────────────────────
# Local dev (AT Proto PDS can't reach you — Google/GitHub OAuth still works):
PUBLIC_URL="http://127.0.0.1:3000"
# For AT Proto OAuth, use cloudflared tunnel (bun run dev:tunnel):
# PUBLIC_URL="https://dev.donguri.app"

# ─── OAuth Providers (optional) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Feedback (optional — in-app feedback → GitHub issues) ──────────────────
# Fine-grained PAT scoped to gusluchetti/donguri, permission: Issues (Read and write)
# GITHUB_FEEDBACK_TOKEN=

# ─── Cover Art (optional — for import/covers.ts) ────────────────────────────
# TMDB_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# ─── Payment (Lemon Squeezy) ─────────────────────────────────────────────
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_RANGER_MONTHLY_VARIANT_ID=
# LEMONSQUEEZY_RANGER_ANNUAL_VARIANT_ID=
# LEMONSQUEEZY_RANGER_LIFETIME_VARIANT_ID=
# LEMONSQUEEZY_DISCOUNT_PPP_60=


# ─── Import Daemon ───────────────────────────────────────────────────────────────
# Daemon schedule (cron format: minute hour day month weekday)
IMPORT_DAEMON_SCHEDULE="0 2 * * *"

# Lock file path for preventing overlapping runs
LOCK_FILE_PATH=/tmp/donguri-import.pid

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=300

# Supplementary data max age (days) for QRank & anime offline DB, default 7
SUPPLEMENTARY_MAX_AGE_DAYS=7

# ─── Email Notifications ───────────────────────────────────────────────────────
# Resend API key for sending notifications
RESEND_API_KEY=

# Sender (must be on a Resend-verified domain) and recipient.
# Emails are skipped unless RESEND_API_KEY, EMAIL_FROM and EMAIL_TO are all set.
EMAIL_FROM=
EMAIL_TO=

# Enable/disable notification types (true by default, set to "false" to opt out)
EMAIL_ON_SUCCESS=true
EMAIL_ON_FAILURE=true
EMAIL_ON_WARNING=true
