{
  "lexicon": 1,
  "id": "app.donguri.catalog.entry",
  "description": "A user's record for a media item — status, rating, notes, and progress.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A catalog entry linking a user to a media item.",
      "record": {
        "type": "object",
        "required": ["mediaRef", "status", "createdAt"],
        "properties": {
          "mediaRef": {
            "type": "string",
            "description": "Wikidata ID of the media item (e.g. Q12345).",
            "maxLength": 32
          },
          "status": {
            "type": "string",
            "description": "Tracking status.",
            "knownValues": [
              "planned",
              "in_progress",
              "on_hold",
              "completed",
              "dropped",
              "mastered"
            ],
            "maxLength": 32
          },
          "rating": {
            "type": "integer",
            "description": "User rating from 1 to 10.",
            "minimum": 1,
            "maximum": 10
          },
          "note": {
            "type": "string",
            "description": "Short review or note.",
            "maxGraphemes": 1000,
            "maxLength": 10000
          },
          "episodeProgress": {
            "type": "integer",
            "description": "Number of episodes watched (for series/anime).",
            "minimum": 0
          },
          "isFavorite": {
            "type": "boolean",
            "description": "Whether this entry is marked as a favorite."
          },
          "replayCount": {
            "type": "integer",
            "description": "Number of times re-watched/replayed.",
            "minimum": 0
          },
          "watchedEpisodes": {
            "type": "object",
            "description": "Map of season number to array of watched episode numbers."
          },
          "title": {
            "type": "string",
            "description": "Media title (for self-describing records).",
            "maxLength": 512
          },
          "mediaType": {
            "type": "string",
            "description": "Media type (movie, tv_series, anime, game).",
            "maxLength": 32
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of record creation."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of last update."
          }
        }
      }
    }
  }
}
