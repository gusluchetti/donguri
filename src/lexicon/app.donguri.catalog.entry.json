{
  "lexicon": 1,
  "id": "app.donguri.catalog.entry",
  "description": "A user's record for a media item — status, rating, notes, and progress.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A catalog entry linking a user to a media item.",
      "record": {
        "type": "object",
        "required": ["mediaRef", "status", "createdAt"],
        "properties": {
          "mediaRef": {
            "type": "string",
            "description": "Wikidata ID of the media item (e.g. Q12345).",
            "maxLength": 32
          },
          "status": {
            "type": "string",
            "description": "Tracking status.",
            "knownValues": ["watching", "completed", "dropped", "plan_to_watch"],
            "maxLength": 32
          },
          "rating": {
            "type": "integer",
            "description": "User rating from 1 to 10.",
            "minimum": 1,
            "maximum": 10
          },
          "note": {
            "type": "string",
            "description": "Short review or note.",
            "maxGraphemes": 1000,
            "maxLength": 10000
          },
          "episodeProgress": {
            "type": "integer",
            "description": "Number of episodes watched (for series/anime).",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of record creation."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp of last update."
          }
        }
      }
    }
  }
}
