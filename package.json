{
  "name": "donguri",
  "version": "2026.05.09",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "docker compose up -d --wait && trap 'docker compose down' EXIT && concurrently -k -n tunnel,vite,db -c magenta,green,yellow \"cloudflared tunnel run donguri-dev\" \"vite dev --port 3000 --host\" \"docker compose logs -f db\"",
    "dev:prod": "concurrently -k -n tunnel,app -c magenta,yellow \"cloudflared tunnel run donguri-dev\" \"docker rm -f donguri-dev 2>/dev/null; docker build -t donguri-dev . && docker run --rm --init --name donguri-dev --network host --env-file .env -e NODE_ENV=production donguri-dev\"",
    "build": "vite build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "start": "node scripts/start.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "validate": "biome check --write --unsafe --error-on-warnings . && biome format --fix . && bun run typecheck",
    "validate-build": "bun run validate && bun run build",
    "import:download": "bun run src/import/main.ts download",
    "import:subset": "bun run src/import/main.ts subset",
    "import:db": "bun run src/import/main.ts db",
    "import:full": "bun run src/import/main.ts full",
    "import:covers": "bun run src/import/main.ts covers",
    "import:qrank": "bun run src/import/main.ts qrank",
    "import:incremental": "bun run src/import/main.ts incremental",
    "import:all": "bun run src/import/main.ts all",
    "import:auto": "bun run src/import/main.ts",
    "db:seed-platforms": "bun run src/db/seed-platforms.ts",
    "comp": "bun run scripts/comp-subscription.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:splash": "node scripts/generate-splash-screens.mjs"
  },
  "dependencies": {
    "@atproto/api": "^0.18.20",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client-node": "^0.3.16",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/query-broadcast-client-experimental": "^5.90.20",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-hotkeys": "^0.4.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.166.16",
    "@tanstack/react-virtual": "^3.13.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "computer-modern": "^0.1.3",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.1",
    "idb-keyval": "^6.2.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sparql-client": "^0.2.0",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "ulid": "^2.3.0",
    "undici": "^7.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@clack/prompts": "^1.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@types/bun": "^1.3.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/csv-parse": "^1.2.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.1",
    "csv-parse": "^6.2.1",
    "react-grab": "^0.1.28",
    "resend": "^3.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.3.0",
    "vitest": "^4.0.18"
  }
}
