{
  "name": "donguri",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "docker compose up -d --wait && trap 'docker compose down' EXIT && concurrently -k -n tunnel,vite -c magenta,green \"cloudflared tunnel run donguri-dev\" \"vite dev --port 3000 --host\"",
    "dev:prod": "concurrently -k -n proxy,tunnel,app -c blue,magenta,yellow \"fly proxy 5432 -a donguri-db\" \"cloudflared tunnel run donguri-dev\" \"docker rm -f donguri-dev 2>/dev/null; docker build -t donguri-dev . && docker run --rm --init --name donguri-dev --network host --env-file .env -e NODE_ENV=production donguri-dev\"",
    "build": "vite build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "start": "node scripts/start.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --fix .",
    "import:update": "bun run src/import/update.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.20",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client-node": "^0.3.16",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/react-hotkeys": "^0.1.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.159.5",
    "@tanstack/react-virtual": "^3.13.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.563.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.3.0"
  }
}
